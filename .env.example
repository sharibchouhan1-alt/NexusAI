# Copy to .env and adjust. .env is git-ignored; never commit real credentials.
# Used by docker-compose.yml and imported automatically by the backend.

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusai
DB_USER=nexusai
DB_PASSWORD=change-me

# Backend
SERVER_PORT=8080
# Comma-separated browser origins allowed to call the API (the frontend's URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Uploaded originals (PDF/TXT). Keep outside the Git checkout; default ~/.nexusai/storage.
# STORAGE_LOCAL_ROOT=/absolute/path/to/nexusai-storage
MAX_UPLOAD_SIZE=25MB
MAX_UPLOAD_REQUEST_SIZE=26MB

# Embeddings: local Ollama (free). Setup: install Ollama, then `ollama pull nomic-embed-text`.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768          # must match vector(768) in V6__create_chunk_embeddings.sql
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_RETRY_INTERVAL=30s      # how often waiting documents are retried while Ollama is down
# OLLAMA_CONNECT_TIMEOUT=2s
# OLLAMA_READ_TIMEOUT=60s
# SEARCH_DEFAULT_LIMIT=10
# SEARCH_MAX_LIMIT=50

# Ingestion (optional overrides)
# INGESTION_CHUNK_SIZE=1200
# INGESTION_CHUNK_OVERLAP=200
# INGESTION_MAX_PAGES=2000
# INGESTION_MAX_TEXT_CHARS=5000000
# INGESTION_WORKER_THREADS=2
# INGESTION_QUEUE_CAPACITY=100
